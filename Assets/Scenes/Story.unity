  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u044B - \u0433\u043E\u0440\u043D\u0438\u0447\u043D\u0430\u044F
    \u0441\u0435\u043C\u044C\u0438 ****, \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0430\u044F
    \u0432\u0441\u0435\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044E\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 YourMaid Inc, \u0433\u043E\u0442\u043E\u0432\u0430\u044F
    \u043A \u0441\u0430\u043C\u043E\u0439 \u0433\u0440\u044F\u0437\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u0435.\n\n\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
    \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u043F\u043E \"\u0443\u0431\u043E\u0440\u043A\u0435\"
    \u0437\u0434\u0430\u043D\u0438\u044F \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430
    \u0432\u0430\u0448\u0435\u0433\u043E \u0445\u043E\u0437\u044F\u0439\u043D\u0430,
    \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0443 \u0432\u0430\u0441 \u043D\u0435\u0442 \u043F\u0440\u0430\u0432\u0430.
    \u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0432 \u0432\u043D\u0443\u0442\u0440\u044C
    \u0432\u0430\u0441 \u0437\u0430\u0441\u0442\u0430\u044E\u0442 \u0432\u0440\u0430\u0441\u043F\u043B\u043E\u0445
    \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u0432\u0441\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B.\n\n\u0412\u044B
    \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0435, \u043D\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0443 \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C
    - \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
    \u0437\u0430\u0434\u0430\u0447\u0443, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u0443\u0441\u043F\u0435\u0445 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
    \u043A \u0433\u0438\u0431\u0435\u043B\u0438.\n\n\u0423\u0434\u0430\u0447\u0438,
    \u041B\u0438\u043B\u0438! "
  m_isRightToLeft: 0
